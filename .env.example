# Copy to .env and adjust: cp .env.example .env

# Required. Any long random string (python -c "import secrets; print(secrets.token_urlsafe(50))").
# Also signs the QR start tokens — changing it invalidates QR codes currently on screen.
BASHDASH_SECRET_KEY=change-me

# Hosts the server answers to. "*" is fine for a demo in a trusted LAN.
BASHDASH_ALLOWED_HOSTS=*

# Address encoded in the QR code — use the host's LAN IP/name and the published port.
BASHDASH_PUBLIC_URL=http://192.168.1.10:8000

# Staff account for /staff and /admin, created on first start.
DJANGO_SUPERUSER_USERNAME=staff
DJANGO_SUPERUSER_PASSWORD=change-me-too

# Optional
# BASHDASH_PORT=8000
# BUILD_PLATFORM=linux/arm64        # default linux/amd64
# BASHDASH_SANDBOX_CONCURRENCY=8
# BASHDASH_GAME_DURATION_S=300
# BASHDASH_START_TOKEN_TTL_S=900
